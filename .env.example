# EchoAPP local development configuration
# Copy this file to .env and adjust for your computer.
# Never commit .env because it may contain secrets in future deployments.

# Local Voicebox desktop application REST API.
VOICEBOX_URL=http://127.0.0.1:17493

# Recommended ASR setting for Chinese reference audio.
# Supported values: base, small, medium, large, turbo.
# turbo offers a practical speed/quality balance; use large only for difficult,
# noisy clips when the machine has sufficient memory.
VOICEBOX_WHISPER_MODEL=turbo

# EchoAPP profiles are Chinese by default. Supplying this hint avoids unreliable
# auto language detection for short reference clips.
VOICEBOX_TRANSCRIPTION_LANGUAGE=zh

# EchoAPP backend API port.
PORT=3000

# Required only when a physical phone connects over the same Wi-Fi network.
# Replace with this computer's LAN IP, then restart Expo.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:3000

# Optional: database and authentication are not required for local voice tests.
# DATABASE_URL=
# JWT_SECRET=
# OAUTH_SERVER_URL=
# VITE_APP_ID=
